<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data extraction / cloud backup rules.
  We include the trial-start prefs so that even after a full app
  reinstall the original trial timestamp is restored from Google Drive,
  preventing the 3-day window from being reset via reinstall.

  NOTE: When explicit <include> tags are present, Android backs up ONLY
  those paths. Everything else (databases, cache, external storage, other
  SharedPreferences files) is excluded automatically — no <exclude> tags
  are needed and adding them for non-included paths triggers Lint error
  FullBackupContent. Keep this file include-only.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="flexboard_settings.xml"/>
        <include domain="sharedpref" path="flexboard_gate.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="flexboard_settings.xml"/>
        <include domain="sharedpref" path="flexboard_gate.xml"/>
    </device-transfer>
</data-extraction-rules>
